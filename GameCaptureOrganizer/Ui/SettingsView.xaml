<UserControl x:Class="GameCaptureOrganizer.Ui.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinWidth="900" MinHeight="580"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/GameCaptureOrganizer;component/Ui/Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Border Background="{StaticResource PageBackgroundBrush}">
        <TabControl Style="{StaticResource TopTabControl}"
                    ItemContainerStyle="{StaticResource TopTabItem}">

            <!-- ============================== Pastas ============================== -->
            <TabItem Header="Pastas">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="18,18,18,24">

                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource TitleBar}" />
                            <StackPanel Grid.Column="1">
                                <TextBlock Style="{StaticResource PageTitle}" Text="Pastas" />
                                <TextBlock Style="{StaticResource PageDescription}"
                                           Text="De onde as capturas do Game Bar saem e para onde vão. É só isto que muda entre o PC e o ROG Ally — o resto da configuração é igual nos dois." />
                            </StackPanel>
                        </Grid>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SectionTitle}" Text="Origem" />
                                <TextBlock Style="{StaticResource FieldLabel}" Text="Pastas onde o Game Bar salva (uma por linha)" />
                                <TextBox Text="{Binding Settings.SourceFolders, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         AcceptsReturn="True" TextWrapping="NoWrap" Height="76"
                                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" />
                                <WrapPanel Margin="0,10,0,0">
                                    <Button Style="{StaticResource GhostButton}" Content="Adicionar pasta…" Click="OnAddSource" />
                                    <Button Style="{StaticResource GhostButton}" Content="Usar o padrão do Windows" Click="OnResetSource" />
                                </WrapPanel>
                                <TextBlock Style="{StaticResource HintText}"
                                           Text="O padrão do Windows é Vídeos\Captures, e vale tanto no PC quanto no Ally. Só acrescente outra pasta se você mudou o destino no próprio Game Bar." />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SectionTitle}" Text="Destino" />
                                <TextBlock Style="{StaticResource FieldLabel}" Text="Pasta onde as capturas organizadas ficam" />
                                <TextBox Text="{Binding Settings.DestinationFolder, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <WrapPanel Margin="0,10,0,0">
                                    <Button Style="{StaticResource GhostButton}" Content="Escolher pasta…" Click="OnPickDestination" />
                                    <Button Style="{StaticResource GhostButton}" Content="Abrir a pasta" Click="OnOpenDestination" />
                                </WrapPanel>
                                <TextBlock Style="{StaticResource HintText}"
                                           Text="O destino não pode ficar dentro da origem (nem o contrário): a passada seguinte reorganizaria o que já foi organizado." />
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ============================== Organização ============================== -->
            <TabItem Header="Organização">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="18,18,18,24">

                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource TitleBar}" />
                            <StackPanel Grid.Column="1">
                                <TextBlock Style="{StaticResource PageTitle}" Text="Organização" />
                                <TextBlock Style="{StaticResource PageDescription}"
                                           Text="Como as pastas e os nomes são montados, e de onde vem o nome do jogo de cada captura." />
                            </StackPanel>
                        </Grid>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SectionTitle}" Text="Padrão de pasta e de nome" />

                                <TextBlock Style="{StaticResource FieldLabel}" Text="Pasta, dentro do destino" />
                                <TextBox Text="{Binding Settings.FolderPattern, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                                <TextBlock Style="{StaticResource FieldLabel}" Text="Nome do arquivo (a extensão é mantida)" />
                                <TextBox Text="{Binding Settings.FilePattern, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                                <Border Style="{StaticResource Separator}" />
                                <TextBlock Style="{StaticResource StatusLabel}" Text="Marcadores disponíveis" />
                                <TextBlock Style="{StaticResource HintText}"
                                           Text="{}{Jogo}  {Tipo}  {Data}  {Hora}  {Ano}  {Mes}  {AnoMes}  {Plataforma}  {Fonte}  {Original}" />
                                <TextBlock Style="{StaticResource HintText}"
                                           Text="{}{Tipo} vira Screenshots ou Videos. Marcador escrito errado aparece como está no nome, em vez de sumir — é assim que o erro fica visível." />

                                <Border Style="{StaticResource Separator}" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Style="{StaticResource StatusLabel}" Text="Como fica" />
                                    <TextBlock Grid.Column="1" x:Name="PreviewText" Style="{StaticResource StatusValue}" />
                                </Grid>
                                <WrapPanel Margin="0,12,0,0">
                                    <Button Style="{StaticResource GhostButton}" Content="Ver exemplo" Click="OnPreview" />
                                    <Button Style="{StaticResource GhostButton}" Content="Voltar ao padrão" Click="OnResetPatterns" />
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SectionTitle}" Text="De onde vem o nome do jogo" />
                                <StackPanel Margin="0,12,0,0">
                                    <CheckBox Content="Usar o jogo que estava rodando no Playnite (recomendado)"
                                              IsChecked="{Binding Settings.MatchBySession, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <CheckBox Content="Procurar o título lido do arquivo na biblioteca do Playnite"
                                              IsChecked="{Binding Settings.MatchByLibrary, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <CheckBox Content="Casar título abreviado com a biblioteca quando houver um único candidato (Pal → Palworld)"
                                              IsChecked="{Binding Settings.MatchByPrefix, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <CheckBox Content="Em último caso, usar o título do próprio nome do arquivo"
                                              IsChecked="{Binding Settings.FallbackToFileName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>

                                <TextBlock Style="{StaticResource FieldLabel}" Text="Folga de horário ao casar captura e sessão (minutos)" />
                                <TextBox Style="{StaticResource NumberBox}"
                                         Text="{Binding Settings.ToleranceMinutes, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Style="{StaticResource FieldLabel}" Text="Apelidos: título da janela = nome do jogo (um por linha)" />
                                <TextBox Text="{Binding Settings.NameAliases, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         AcceptsReturn="True" TextWrapping="NoWrap" Height="76"
                                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" />
                                <TextBlock Style="{StaticResource HintText}"
                                           Text="O Game Bar nomeia o arquivo pelo título da JANELA, que às vezes não é o nome do jogo: a janela do Palworld se chama &quot;Pal&quot;. Nenhuma regra de texto adivinha isso — por isso a equivalência é declarada aqui, e passa a valer para sempre." />

                                <TextBlock Style="{StaticResource HintText}"
                                           Text="A sessão do Playnite é o dado mais confiável porque não depende do título da janela. Com todas as opções desligadas nada é organizado — a captura fica onde está, de propósito." />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SectionTitle}" Text="Quando rodar" />
                                <StackPanel Margin="0,12,0,0">
                                    <CheckBox Content="Ao fechar um jogo"
                                              IsChecked="{Binding Settings.OrganizeAfterGame, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <CheckBox Content="Ao abrir o Playnite (pega o que ficou para trás)"
                                              IsChecked="{Binding Settings.OrganizeOnStartup, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <CheckBox Content="Mover os arquivos (desmarcado, copia e mantém o original)"
                                              IsChecked="{Binding Settings.MoveFiles, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <CheckBox Content="Avisar por notificação quando organizar algo"
                                              IsChecked="{Binding Settings.ShowNotification, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>

                                <TextBlock Style="{StaticResource FieldLabel}" Text="Espera depois que o jogo fecha (segundos)" />
                                <TextBox Style="{StaticResource NumberBox}"
                                         Text="{Binding Settings.DelaySeconds, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Style="{StaticResource HintText}"
                                           Text="Dá tempo ao Game Bar de terminar de gravar o vídeo. Se ainda estiver gravando, o arquivo é deixado para a passada seguinte em vez de dar erro." />

                                <WrapPanel Margin="0,14,0,0">
                                    <Button Style="{StaticResource PrimaryButton}" Content="Organizar agora" Click="OnOrganizeNow" />
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ============================== Avançado ============================== -->
            <TabItem Header="Avançado">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="18,18,18,24">

                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource TitleBar}" />
                            <StackPanel Grid.Column="1">
                                <TextBlock Style="{StaticResource PageTitle}" Text="Avançado" />
                                <TextBlock Style="{StaticResource PageDescription}"
                                           Text="Quais arquivos contam como captura, o registro do que foi feito e a atualização da própria extensão." />
                            </StackPanel>
                        </Grid>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SectionTitle}" Text="Tipos de arquivo" />
                                <TextBlock Style="{StaticResource FieldLabel}" Text="Imagens" />
                                <TextBox Text="{Binding Settings.ImageExtensions, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Style="{StaticResource FieldLabel}" Text="Vídeos" />
                                <TextBox Text="{Binding Settings.VideoExtensions, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Style="{StaticResource HintText}"
                                           Text="Separe por vírgula. Arquivo de extensão desconhecida é ignorado e fica onde está." />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SectionTitle}" Text="Registro" />
                                <StackPanel Margin="0,12,0,0">
                                    <CheckBox Content="Gravar um log de cada passada"
                                              IsChecked="{Binding Settings.WriteLog, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <WrapPanel Margin="0,12,0,0">
                                    <Button Style="{StaticResource GhostButton}" Content="Abrir o log" Click="OnOpenLog" />
                                </WrapPanel>
                                <TextBlock Style="{StaticResource HintText}"
                                           Text="O log mostra, por arquivo, para onde ele foi e de onde veio o nome do jogo — sessão, biblioteca ou nome do arquivo. É por ele que se descobre por que uma captura foi parar na pasta errada." />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SectionTitle}" Text="Atualização da extensão" />
                                <Border Style="{StaticResource Separator}" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Style="{StaticResource StatusLabel}" Text="Versão instalada" />
                                    <TextBlock Grid.Column="1" x:Name="VersionText" Style="{StaticResource StatusValue}" />
                                </Grid>
                                <WrapPanel Margin="0,14,0,0">
                                    <Button Style="{StaticResource PrimaryButton}" Content="Verificar atualizações" Click="OnCheckUpdates" />
                                </WrapPanel>
                                <TextBlock Style="{StaticResource HintText}"
                                           Text="Consulta as releases publicadas no GitHub. Havendo versão mais nova, o arquivo é baixado, o Playnite fecha, troca os arquivos e abre de novo sozinho." />
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

        </TabControl>
    </Border>
</UserControl>
