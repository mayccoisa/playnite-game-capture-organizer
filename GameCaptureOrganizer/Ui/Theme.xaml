<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib"
                    xmlns:ui="clr-namespace:GameCaptureOrganizer.Ui">

    <!--
        O visual desta extensao segue o padrao da tela de configuracoes do Aniki Helper.
        Os valores abaixo sao os literais lidos do BAML dele, nao aproximacoes de captura
        de tela: superficie escura levemente azulada, borda ciano tenue, sombra difusa,
        acento ciano e o dourado reservado para a aba selecionada.

        A paleta e escura por decisao, como a do proprio Aniki. Nao derivamos as
        superficies dos brushes do tema do Playnite porque a maior parte deles nao existe
        com o mesmo nome em todo tema instalado, e um DynamicResource que nao resolve
        deixa o painel transparente. So a fonte e herdada do tema, para a extensao
        continuar parecendo parte do app da pessoa.
    -->

    <!-- ============================ Cores ============================ -->

    <SolidColorBrush x:Key="Surface1Brush"        Color="#E61A2026" />
    <SolidColorBrush x:Key="BorderBrushSoft"      Color="#26FFFFFF" />
    <SolidColorBrush x:Key="BorderBrushHover"     Color="#3DFFFFFF" />
    <SolidColorBrush x:Key="SeparatorBrush"       Color="#1FFFFFFF" />
    <SolidColorBrush x:Key="TextPrimaryBrush"     Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="TextSecondaryBrush"   Color="#FFB3B3B3" />
    <SolidColorBrush x:Key="TextMutedBrush"       Color="#FF8A8A8A" />
    <SolidColorBrush x:Key="AccentBrush"          Color="#FF32CFE5" />
    <SolidColorBrush x:Key="AccentSoftBrush"      Color="#3A32CFE5" />
    <SolidColorBrush x:Key="GoldBrush"            Color="#FFE6B86A" />
    <SolidColorBrush x:Key="GreenBrush"           Color="#FF70D89B" />
    <SolidColorBrush x:Key="AmberBrush"           Color="#FFE5A16A" />
    <SolidColorBrush x:Key="DangerBrush"          Color="#FFFF7474" />
    <SolidColorBrush x:Key="PanelBorderBrush"     Color="#38FFFFFF" />
    <SolidColorBrush x:Key="CardBorderBrush"      Color="#3547D7E9" />
    <SolidColorBrush x:Key="FieldBackgroundBrush" Color="#B8141B22" />
    <SolidColorBrush x:Key="FieldBorderBrush"     Color="#30FFFFFF" />

    <!-- Cores cruas, para quem desenha grafico em codigo. -->
    <Color x:Key="ChartEmptyColor">#33888888</Color>
    <Color x:Key="ChartGridColor">#22FFFFFF</Color>

    <LinearGradientBrush x:Key="PageBackgroundBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#E90D1319" Offset="0" />
        <GradientStop Color="#E6071119" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="CardBackgroundBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#F21D2329" Offset="0" />
        <GradientStop Color="#EC14191F" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="HomeCardBackgroundBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#F0182029" Offset="0" />
        <GradientStop Color="#F00C151D" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="HeroBackgroundBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#E8182028" Offset="0" />
        <GradientStop Color="#DB10171D" Offset="1" />
    </LinearGradientBrush>

    <!-- ============================ Conversores ============================ -->

    <ui:BoolToOnOffConverter x:Key="OnOff" />
    <ui:BoolToStatusBrushConverter x:Key="OnOffBrush" />
    <ui:EmptyStringToVisibilityConverter x:Key="EmptyToVisible" />
    <ui:FilledStringToVisibilityConverter x:Key="FilledToVisible" />
    <ui:BoolToVisibilityConverter x:Key="BoolToVisible" />
    <ui:NullableDateToTextConverter x:Key="Stamp" />
    <ui:TextOrDashConverter x:Key="TextOrDash" />

    <!-- ============================ Texto ============================ -->

    <Style TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
    </Style>

    <Style x:Key="PageTitle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="FontSize" Value="22" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
    </Style>

    <Style x:Key="PageDescription" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="LineHeight" Value="18" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Margin" Value="0,6,0,0" />
    </Style>

    <Style x:Key="SectionTitle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="FieldLabel" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Margin" Value="0,14,0,5" />
    </Style>

    <Style x:Key="HintText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="LineHeight" Value="18" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Margin" Value="0,7,0,0" />
    </Style>

    <Style x:Key="MutedText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="StatusLabel" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="StatusValue" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="TextAlignment" Value="Right" />
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- ============================ Superficies ============================ -->

    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource CardBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="18,15,18,17" />
        <Setter Property="Margin" Value="0,0,0,14" />
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect Color="#000000" BlurRadius="16" ShadowDepth="2" Opacity="0.28" />
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="HomeCard" TargetType="Border" BasedOn="{StaticResource Card}">
        <Setter Property="Background" Value="{StaticResource HomeCardBackgroundBrush}" />
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect Color="#000000" BlurRadius="18" ShadowDepth="2" Opacity="0.32" />
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="HeroCard" TargetType="Border" BasedOn="{StaticResource Card}">
        <Setter Property="Background" Value="{StaticResource HeroBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="#3047D7E9" />
        <Setter Property="Padding" Value="20,18" />
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect Color="#000000" BlurRadius="20" ShadowDepth="2" Opacity="0.22" />
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        Linha de lista: mesma familia do card, sem sombra e com folga menor. Sombra em cada
        item de uma lista de dez aparelhos vira ruido, e nao hierarquia.
    -->
    <Style x:Key="RowCard" TargetType="Border">
        <Setter Property="Background" Value="#12FFFFFF" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="9" />
        <Setter Property="Padding" Value="14,11" />
        <Setter Property="Margin" Value="0,0,0,8" />
    </Style>

    <!-- Etiqueta de tipo, no fim da linha do aparelho. -->
    <Style x:Key="Chip" TargetType="Border">
        <Setter Property="Background" Value="#1832CFE5" />
        <Setter Property="BorderBrush" Value="#4032CFE5" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="10,3" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="ChipText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <!-- A barrinha vertical a esquerda do titulo de pagina. -->
    <Style x:Key="TitleBar" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource AccentBrush}" />
        <Setter Property="Width" Value="4" />
        <Setter Property="CornerRadius" Value="2" />
        <Setter Property="Margin" Value="0,2,14,2" />
    </Style>

    <Style x:Key="Separator" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource SeparatorBrush}" />
        <Setter Property="Height" Value="1" />
        <Setter Property="Margin" Value="0,14,0,14" />
    </Style>

    <!-- Quadradinho com a inicial, no cabecalho de cada card da Home. -->
    <Style x:Key="Badge" TargetType="Border">
        <Setter Property="Background" Value="#2232CFE5" />
        <Setter Property="BorderBrush" Value="#7032CFE5" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="9" />
        <Setter Property="Width" Value="34" />
        <Setter Property="Height" Value="34" />
        <Setter Property="Margin" Value="0,0,12,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="BadgeText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="GoldBadge" TargetType="Border" BasedOn="{StaticResource Badge}">
        <Setter Property="Background" Value="#22E6B86A" />
        <Setter Property="BorderBrush" Value="#70E6B86A" />
    </Style>

    <Style x:Key="GoldBadgeText" TargetType="TextBlock" BasedOn="{StaticResource BadgeText}">
        <Setter Property="Foreground" Value="{StaticResource GoldBrush}" />
    </Style>

    <!-- ============================ Avisos ============================ -->

    <Style x:Key="WarningBanner" TargetType="Border">
        <Setter Property="Background" Value="#22E6B86A" />
        <Setter Property="BorderBrush" Value="#58E6B86A" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="9" />
        <Setter Property="Padding" Value="16,13" />
        <Setter Property="Margin" Value="0,0,0,14" />
    </Style>

    <Style x:Key="DangerBanner" TargetType="Border" BasedOn="{StaticResource WarningBanner}">
        <Setter Property="Background" Value="#26FF5C5C" />
        <Setter Property="BorderBrush" Value="#78FF5C5C" />
    </Style>

    <Style x:Key="OkBanner" TargetType="Border" BasedOn="{StaticResource WarningBanner}">
        <Setter Property="Background" Value="#1E39C878" />
        <Setter Property="BorderBrush" Value="#5536D17A" />
    </Style>

    <Style x:Key="BannerTitle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="FontSize" Value="13.5" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="BannerText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="#C8D0D5D9" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="LineHeight" Value="18" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Margin" Value="0,4,0,0" />
    </Style>

    <!-- Bolinha com o glifo, a esquerda do banner. -->
    <Style x:Key="BannerGlyph" TargetType="Border">
        <Setter Property="Width" Value="26" />
        <Setter Property="Height" Value="26" />
        <Setter Property="CornerRadius" Value="13" />
        <Setter Property="Background" Value="#2AE6B86A" />
        <Setter Property="BorderBrush" Value="#A8E6B86A" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Margin" Value="0,0,12,0" />
        <Setter Property="VerticalAlignment" Value="Top" />
    </Style>

    <Style x:Key="BannerGlyphText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource GoldBrush}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- ============================ Botoes ============================ -->

    <Style x:Key="PrimaryButton" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Padding" Value="15,8" />
        <Setter Property="Margin" Value="0,0,8,6" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="border"
                            Background="#1732CFE5"
                            BorderBrush="#6A32CFE5"
                            BorderThickness="1"
                            CornerRadius="7"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="Background" Value="#2732CFE5" />
                            <Setter TargetName="border" Property="BorderBrush" Value="#B032CFE5" />
                            <Setter TargetName="border" Property="Effect">
                                <Setter.Value>
                                    <DropShadowEffect Color="#32CFE5" BlurRadius="12" ShadowDepth="0" Opacity="0.20" />
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="border" Property="Background" Value="#1232CFE5" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="border" Property="BorderBrush" Value="#B032CFE5" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="border" Property="Opacity" Value="0.42" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="border"
                            Background="#26FF5C5C"
                            BorderBrush="#A6FF5C5C"
                            BorderThickness="1"
                            CornerRadius="7"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="Background" Value="#3DFF5C5C" />
                            <Setter TargetName="border" Property="BorderBrush" Value="#E6FF7474" />
                            <Setter TargetName="border" Property="Effect">
                                <Setter.Value>
                                    <DropShadowEffect Color="#FF5C5C" BlurRadius="12" ShadowDepth="0" Opacity="0.22" />
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="border" Property="Background" Value="#1FFF5C5C" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="border" Property="Opacity" Value="0.42" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Botao discreto, para acao secundaria dentro de um card. -->
    <Style x:Key="GhostButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="Padding" Value="13,7" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="border"
                            Background="#10FFFFFF"
                            BorderBrush="{StaticResource BorderBrushSoft}"
                            BorderThickness="1"
                            CornerRadius="7"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="Background" Value="#1AFFFFFF" />
                            <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource BorderBrushHover}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="border" Property="Opacity" Value="0.42" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Botao do banner: fica a direita, alinhado ao centro do bloco de texto. -->
    <Style x:Key="BannerButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
        <Setter Property="Margin" Value="16,0,0,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- ============================ Campos ============================ -->

    <Style TargetType="TextBox">
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="CaretBrush" Value="{StaticResource AccentBrush}" />
        <Setter Property="SelectionBrush" Value="{StaticResource AccentBrush}" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Padding" Value="10,7" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="border"
                            Background="{StaticResource FieldBackgroundBrush}"
                            BorderBrush="{StaticResource FieldBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="7">
                        <ScrollViewer x:Name="PART_ContentHost"
                                      Margin="{TemplateBinding Padding}"
                                      VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource BorderBrushHover}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="border" Property="BorderBrush" Value="#8532CFE5" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="border" Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="NumberBox" TargetType="TextBox">
        <Setter Property="Width" Value="70" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
    </Style>

    <Style TargetType="CheckBox">
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Margin" Value="0,4,0,4" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <StackPanel Orientation="Horizontal" Background="Transparent">
                        <Border x:Name="box"
                                Width="17" Height="17"
                                CornerRadius="5"
                                Background="#14FFFFFF"
                                BorderBrush="{StaticResource BorderBrushSoft}"
                                BorderThickness="1"
                                VerticalAlignment="Center">
                            <Path x:Name="check"
                                  Data="M 0,3.6 L 3.1,6.8 L 8.6,0.6"
                                  Stroke="#FF0E1418"
                                  StrokeThickness="2"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  Visibility="Collapsed" />
                        </Border>
                        <ContentPresenter x:Name="label"
                                          Margin="10,0,0,0"
                                          VerticalAlignment="Center"
                                          RecognizesAccessKey="True" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="box" Property="Background" Value="{StaticResource AccentBrush}" />
                            <Setter TargetName="box" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            <Setter TargetName="check" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="box" Property="BorderBrush" Value="#8532CFE5" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================ Abas do topo ============================ -->

    <Style x:Key="TopTabControl" TargetType="TabControl">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabControl">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0"
                                BorderBrush="{StaticResource SeparatorBrush}"
                                BorderThickness="0,0,0,1"
                                Padding="18,10,18,0">
                            <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                          VerticalScrollBarVisibility="Disabled">
                                <TabPanel IsItemsHost="True" />
                            </ScrollViewer>
                        </Border>
                        <ContentPresenter Grid.Row="1" ContentSource="SelectedContent" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="TopTabItem" TargetType="TabItem">
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Padding" Value="18,12,18,8" />
        <Setter Property="Margin" Value="2,0,8,0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <Grid Background="Transparent">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <ContentPresenter Grid.Row="0"
                                          ContentSource="Header"
                                          Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                        <Border x:Name="SelectedLine"
                                Grid.Row="1"
                                Height="2"
                                Margin="10,0"
                                CornerRadius="1"
                                Background="{StaticResource GoldBrush}"
                                Visibility="Collapsed" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="SelectedLine" Property="Visibility" Value="Visible" />
                            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================ Abas laterais ============================ -->

    <Style x:Key="SideTabControl" TargetType="TabControl">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="TabStripPlacement" Value="Left" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabControl">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" IsItemsHost="True" Margin="0,2,0,0" MinWidth="170" />
                        <ContentPresenter Grid.Column="1" ContentSource="SelectedContent" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SideTabItem" TargetType="TabItem">
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Padding" Value="17,11" />
        <Setter Property="Margin" Value="0,0,14,6" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <Border x:Name="SideTabBorder"
                            Background="Transparent"
                            BorderBrush="Transparent"
                            BorderThickness="4,0,0,0"
                            CornerRadius="0,10,10,0"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter ContentSource="Header"
                                          HorizontalAlignment="Left"
                                          VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="SideTabBorder" Property="Background" Value="#2032CFE5" />
                            <Setter TargetName="SideTabBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="SideTabBorder" Property="Background" Value="#1432CFE5" />
                            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================ Tabelas ============================ -->

    <Style TargetType="DataGridColumnHeader">
        <Setter Property="Background" Value="#14FFFFFF" />
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Padding" Value="10,8" />
        <Setter Property="BorderBrush" Value="{StaticResource SeparatorBrush}" />
        <Setter Property="BorderThickness" Value="0,0,1,1" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
    </Style>

    <Style TargetType="DataGridRow">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#0E32CFE5" />
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="#2032CFE5" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="DataGridCell">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="10,7" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridCell">
                    <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                        <ContentPresenter VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ThemedDataGrid" TargetType="DataGrid">
        <Setter Property="Background" Value="#10FFFFFF" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="RowBackground" Value="Transparent" />
        <Setter Property="AlternatingRowBackground" Value="#08FFFFFF" />
        <Setter Property="GridLinesVisibility" Value="Horizontal" />
        <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource SeparatorBrush}" />
        <Setter Property="HeadersVisibility" Value="Column" />
        <Setter Property="AutoGenerateColumns" Value="False" />
        <Setter Property="CanUserAddRows" Value="False" />
        <Setter Property="RowHeaderWidth" Value="0" />
    </Style>

    <!-- ============================ Arvore de pastas ============================ -->

    <!--
        O TreeViewItem do WPF vem com template proprio e ele NAO acompanha tema escuro: o chevron
        expandido e desenhado com Fill #FF595959 e Stroke #FF262626, que sobre o fundo escuro desta
        extensao e cinza-escuro sobre cinza-escuro — a seta some e a pasta parece nao ter nada
        dentro. Trocar so o Foreground nao resolve, porque o chevron nao le o Foreground. Por isso
        o template inteiro e refeito aqui, com a seta puxando a cor do tema.
    -->
    <Style x:Key="TreeChevron" TargetType="ToggleButton">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Width" Value="16" />
        <Setter Property="Height" Value="16" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border Background="Transparent" Width="16" Height="16">
                        <Path x:Name="Seta" Data="M 4,2 L 9,7 L 4,12"
                              Stroke="{StaticResource TextMutedBrush}" StrokeThickness="1.6"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              StrokeLineJoin="Round"
                              HorizontalAlignment="Center" VerticalAlignment="Center"
                              RenderTransformOrigin="0.45,0.5">
                            <Path.RenderTransform>
                                <RotateTransform Angle="0" />
                            </Path.RenderTransform>
                        </Path>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Seta" Property="RenderTransform">
                                <Setter.Value>
                                    <RotateTransform Angle="90" />
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Seta" Property="Stroke" Value="{StaticResource AccentBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="TreeViewItem">
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Padding" Value="6,4" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <!-- O no guarda o proprio estado de expansao: sem isto, recarregar a arvore fecha tudo e
             quem estava tres niveis abaixo volta para a raiz a cada "Atualizar". -->
        <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TreeViewItem">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <ToggleButton x:Name="Expander" Grid.Row="0" Grid.Column="0"
                                      VerticalAlignment="Center"
                                      Style="{StaticResource TreeChevron}"
                                      IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}}"
                                      ClickMode="Press" />

                        <Border x:Name="Selo" Grid.Row="0" Grid.Column="1"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}"
                                CornerRadius="4">
                            <ContentPresenter ContentSource="Header" HorizontalAlignment="Stretch" />
                        </Border>

                        <ItemsPresenter x:Name="Filhos" Grid.Row="1" Grid.Column="1"
                                        Margin="10,0,0,0" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsExpanded" Value="False">
                            <Setter TargetName="Filhos" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="HasItems" Value="False">
                            <Setter TargetName="Expander" Property="Visibility" Value="Hidden" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Selo" Property="Background" Value="#0E32CFE5" />
                        </Trigger>
                        <!-- O fundo da selecao mora no Selo, que e IRMAO do ItemsPresenter. Pintar
                             o Grid inteiro tingiria junto toda a subarvore aberta embaixo. -->
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Selo" Property="Background" Value="#2632CFE5" />
                            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
